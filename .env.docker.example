# Copia este archivo a .env.docker y llena los valores reales.
# .env.docker NUNCA se sube al repo (está en .gitignore) — esto es solo
# la plantilla para saber qué variables hacen falta en cada ambiente.
#
# Aparte de esto: si el puerto 8000 del host ya está ocupado (revisa con
# `sudo ss -tulpn | grep 8000`), no se cambia aquí — se pone WEB_PORT=8001
# (o el puerto libre que corresponda) en el archivo .env de la raíz del
# repo (el que lee docker-compose.yml para sus propias variables, junto
# a docker-compose.yml — no dentro del contenedor como este archivo).

# Genera una nueva para cada ambiente real (nunca reuses la de desarrollo):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

DEBUG=False
SECURE_SSL_REDIRECT=False

# Solo para pruebas por ngrok en local. En el VPS real, deja esto vacío
# o pon el dominio real si hace falta (normalmente no, ya está en
# ALLOWED_HOSTS de settings.py).
EXTRA_ALLOWED_HOSTS=
EXTRA_CSRF_TRUSTED_ORIGINS=

# Credenciales de la base (usadas también por el servicio "db" de docker-compose)
DB_NAME=dinnerschool_db
DB_USER=dinnerschool_user
DB_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

EMAIL_HOST_USER=info@cafeteriacerto.com
EMAIL_HOST_PASSWORD=
SITE_URL=https://cafeteriacerto.com
